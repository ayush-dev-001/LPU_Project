// ProjectPulse — database schema
// Owner: team lead. Any change to this file must be requested in your PR description
// and follow CONTRIBUTING.md ("Changing the schema").

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  ADMIN // manages users and sees everything
  MANAGER // creates and runs projects
  MEMBER // works on assigned tasks
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ExpenseCategory {
  LABOUR
  MATERIAL
  EQUIPMENT
  SOFTWARE
  TRAVEL
  OTHER
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_DUE_SOON
  TASK_OVERDUE
  MILESTONE_DUE_SOON
  BUDGET_ALERT
  PROJECT_UPDATE
  GENERAL
}

// ───────────────────────────── Users ─────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(MEMBER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  managedProjects Project[]        @relation("ProjectManager")
  memberships     ProjectMember[]
  assignedTasks   Task[]           @relation("TaskAssignee")
  createdTasks    Task[]           @relation("TaskCreator")
  updates         ProgressUpdate[]
  expenses        Expense[]
  documents       Document[]
  notifications   Notification[]
  activities      ActivityLog[]
}

// ──────────────────────────── Projects ───────────────────────────

model Project {
  id            String        @id @default(cuid())
  code          String        @unique // short human id, e.g. "PRJ-001"
  name          String
  description   String?
  status        ProjectStatus @default(PLANNING)
  startDate     DateTime
  endDate       DateTime // planned end date
  budget        Int           @default(0) // planned budget in whole rupees (INR)
  managerId     String
  manager       User          @relation("ProjectManager", fields: [managerId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  members    ProjectMember[]
  milestones Milestone[]
  tasks      Task[]
  updates    ProgressUpdate[]
  expenses   Expense[]
  documents  Document[]
  activities ActivityLog[]

  @@index([managerId])
  @@index([status])
}

model ProjectMember {
  projectId String
  userId    String
  joinedAt  DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime
  status      MilestoneStatus @default(PENDING)
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tasks Task[]

  @@index([projectId])
}

model Task {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId String?
  milestone   Milestone?   @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  assigneeId  String?
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User         @relation("TaskCreator", fields: [createdById], references: [id])
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime? // set when status becomes DONE, cleared otherwise
  position    Int          @default(0) // order inside a Kanban column
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  documents Document[]

  @@index([projectId, status])
  @@index([assigneeId])
  @@index([milestoneId])
}

// ───────────────────── Progress, budget, documents ─────────────────────

model ProgressUpdate {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId        String
  author          User     @relation(fields: [authorId], references: [id])
  summary         String // what was done
  blockers        String? // what is stopping progress
  percentComplete Int? // author's estimate 0–100, optional
  createdAt       DateTime @default(now())

  @@index([projectId, createdAt])
}

model Expense {
  id           String          @id @default(cuid())
  projectId    String
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String
  amount       Int // whole rupees (INR)
  category     ExpenseCategory @default(OTHER)
  spentOn      DateTime
  recordedById String
  recordedBy   User            @relation(fields: [recordedById], references: [id])
  createdAt    DateTime        @default(now())

  @@index([projectId, spentOn])
}

model Document {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId       String?
  task         Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  name         String // original file name
  url          String // where the file can be downloaded from
  storageKey   String // key/path inside the storage provider (used to delete)
  mimeType     String
  size         Int // bytes
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([projectId])
  @@index([taskId])
}

// ─────────────────────── Notifications & activity ───────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(GENERAL)
  title     String
  message   String
  link      String? // in-app path to open, e.g. "/projects/abc"
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
}

// Written through logActivity() in src/lib/activity.ts — never directly.
model ActivityLog {
  id         String   @id @default(cuid())
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String // e.g. "task.created", "task.status_changed", "expense.added"
  entityType String // e.g. "Task", "Expense"
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt])
}
