# Copy this file to `.env` and fill in the values. Never commit `.env`.

# PostgreSQL connection string.
# Easiest local option: run `npx prisma dev` and copy the "TCP" postgres:// URL it prints.
# Any Postgres works (Docker, Neon free tier, local install).
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Only needed with `npx prisma dev` (it runs a separate shadow DB on the next port).
# With a normal Postgres server, delete this line.
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# Secret used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="replace-with-a-long-random-string"

# Protects /api/cron/alerts (automatic due-date and overdue alerts).
# Any long random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET="replace-with-another-long-random-string"

# Optional. Store uploaded documents in a private Vercel Blob store instead of ./uploads.
# Needed on Vercel (its disk is not kept). Vercel adds this automatically when you
# connect a Blob store to the project (Storage tab). Leave it out for local development.
# BLOB_READ_WRITE_TOKEN=""
